bootdelay=3
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

preboot=scsi scan

# Shortcut to enable USB serial gadget and disable bootretry
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget; \
	echo "Hold the power button to return to the menu"

# The boot menu is the landing point. Anything that returns to the
# shell (menu command exit, failed boot, error) re-opens the menu
# instead of falling through to a kernel.
bootcmd=run menucmd

# Boot the FIT image (mainline kernel) that ABL loaded into RAM as
# the boot.img ramdisk slot. Same mechanism as starqltechn (S9).
boot_fit=bootm $prevbl_initrd_start_addr

# Re-open the boot menu. bootmenu -1 runs forever; the menu entry
# commands themselves decide what to do on return.
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Enter Samsung/Qualcomm boot modes via the Android BCB (misc).
recovery_mode=bcb load mmc 0 misc; bcb set command boot-recovery; \
	bcb set recovery recovery; bcb store; reset

bootmenu_0=Boot pmOS=bootm $prevbl_initrd_start_addr
bootmenu_1=Enter fastboot mode=run fastboot; sleep 1; run menucmd
bootmenu_2=Enter recovery mode=run recovery_mode
bootmenu_3=Reboot=reset
bootmenu_4=Power off=poweroff

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
